{
  "name": "vue-context-ts",
  "version": "1.1.0",
  "type": "module",
  "keywords": [
    "vue",
    "provide",
    "inject",
    "context"
  ],
  "author": "Maxim Molochkov <klaseca@gmail.com> (https://github.com/klaseca)",
  "license": "MIT",
  "description": "Typesafe vue context",
  "homepage": "https://github.com/klaseca/vue-context-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klaseca/vue-context-ts.git"
  },
  "bugs": {
    "url": "https://github.com/klaseca/vue-context-ts/issues"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.14"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11"
    }
  },
  "files": [
    "./dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    "default": "./dist/index.js"
  },
  "scripts": {
    "prepare": "husky",
    "prebuild": "npm run test && node ./scripts/rmrf.js ./dist",
    "build": "npm run build:raw",
    "build:raw": "tsc -p ./tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "prettier -w -u .",
    "prerelease": "npm run build",
    "release": "bumpp && npm publish"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vue/test-utils": "^2.4.10",
    "bumpp": "^11.1.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.5",
    "vue": "^3.5.34"
  },
  "peerDependencies": {
    "vue": "^3"
  }
}
